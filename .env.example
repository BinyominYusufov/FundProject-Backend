# Copy this file to .env, or just run the app — every value below has a sane
# default baked into config/settings.py and config/dev_auth.py, so a fresh
# clone with NO .env file boots successfully on an empty database.

# A SECRET_KEY is auto-generated and cached to .secret_key on first run if unset.
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Auth / dev-mode flags ----
# Defaults below = fully autonomous dev mode. Flip them for production.
ENABLE_AUTH=false
DEV_PUBLIC_MODE=true
REQUIRE_ADMIN_FOR_DELETE=true

# ---- Bootstrap flags ----
# AUTO_BOOTSTRAP silently creates a default Organization + admin + fund-owner
# user whenever they are missing — at app start, after migrations, and as a
# fallback inside views/serializers. Disable in production.
AUTO_BOOTSTRAP=true
ALLOW_EMPTY_DATABASE=true
MOCK_EXTERNAL_SERVICES=true

# ---- Email (only used when MOCK_EXTERNAL_SERVICES=false) ----
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# ---- Production-only ----
# Set DEBUG=False, ENABLE_AUTH=true, DEV_PUBLIC_MODE=false, AUTO_BOOTSTRAP=false.
# SECURE_SSL_REDIRECT=true
